# Dependencies and generated Next.js output
/node_modules/
/.next/
/out/
/next-env.d.ts
/tsconfig.tsbuildinfo

# Generated test reports and coverage
/test-results/
/playwright-report/
/coverage/

# Local environment settings; keep useful templates
.env
.env.*
!.env.example
!.env.*.example

# Local deployment metadata and tool caches
/.vercel/
/.cache/
/.eslintcache

# Package-manager debug logs
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/pnpm-debug.log*

# Local editor/OS artifacts; shared editor configuration stays trackable
/.idea/
/.history/
/.vscode/*.local.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Existing local design references (retained, not application assets)
/ref/
